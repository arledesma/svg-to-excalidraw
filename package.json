{
  "name": "svg-to-excalidraw",
  "version": "0.1.0",
  "description": "Convert SVG to Excalidraw’s file format",
  "main": "dist/bundle.js",
  "files": [
    "dist/bundle.js",
    "svg-to-excalidraw.d.ts"
  ],
  "types": "svg-to-excalidraw.d.ts",
  "bin": {
    "svg-to-excalidraw": "cli.ts"
  },
  "scripts": {
    "convert": "tsx cli.ts",
    "build": "NODE_OPTIONS=--openssl-legacy-provider webpack --config webpack.config.js",
    "build:watch": "NODE_OPTIONS=--openssl-legacy-provider webpack --config webpack.config.js --watch",
    "clean": "rimraf dist",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{css,scss,json,md,html,yml}\" --ignore-path=.eslintignore",
    "format:check": "prettier --list-different \"**/*.{css,scss,json,md,html,yml}\" --ignore-path=.eslintignore",
    "typecheck": "tsc"
  },
  "prettier": "@excalidraw/prettier-config",
  "contributors": [
    "Nicolas Goudry <goudry.nicolas@gmail.com>",
    "Broch Stilley <brochington@gmail.com>"
  ],
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "7.15.5",
    "@babel/plugin-proposal-class-properties": "7.14.5",
    "@babel/plugin-proposal-object-rest-spread": "7.14.7",
    "@babel/plugin-syntax-dynamic-import": "7.8.3",
    "@babel/preset-env": "7.15.4",
    "@babel/preset-typescript": "7.15.0",
    "@excalidraw/eslint-config": "1.0.1",
    "@excalidraw/prettier-config": "1.0.2",
    "@types/chroma-js": "^2.1.3",
    "@types/node": "^25.8.0",
    "@typescript-eslint/eslint-plugin": "4.31.0",
    "@typescript-eslint/parser": "4.31.0",
    "babel-loader": "^8.2.2",
    "eslint": "7.32.0",
    "eslint-config-prettier": "8.3.0",
    "eslint-plugin-prettier": "4.0.0",
    "prettier": "2.3.2",
    "rimraf": "^6.1.3",
    "tsx": "^4.22.0",
    "typescript": "^5.8.3",
    "webpack": "5.52.0",
    "webpack-cli": "4.8.0"
  },
  "dependencies": {
    "chroma-js": "^2.1.2",
    "gl-matrix": "^3.3.0",
    "linkedom": "^0.18.12",
    "nanoid": "^3.1.25",
    "path-data-parser": "^0.1.0",
    "points-on-curve": "^0.2.0",
    "points-on-path": "^0.2.1",
    "roughjs": "^4.4.1"
  }
}
